}

require fuzzel
require wl-copy
list="$(emoji_list)"
lines="$(printf '%s\n' "$list" | menu_lines 12)"
selection="$(printf '%s\n' "$list" | fuzzel --namespace=fz-emoji --dmenu --width 44 --lines "$lines" --prompt 'Emoji: ')"
[ -n "$selection" ] || exit 0
emoji="$(printf '%s' "$selection" | awk '{ print $1 }')"
printf '%s' "$emoji" | wl-copy
notify 'Emoji' "Copied $emoji" smile normal
