#!/bin/sh
set -eu

require() {
  command -v "$1" >/dev/null 2>&1 || {
    notify 'Emoji' "$1 not found" dialog-error critical
    exit 1
  }
}

menu_lines() {
  max="$1"

  awk -v max="$max" '
    END {
      lines = NR < 1 ? 1 : NR
      if (lines > max) {
        print max
      } else {
        print lines
      }
    }
  '
}

