#!/bin/sh
set -eu

documents_dir="${XDG_DOCUMENTS_DIR:-$HOME/Documents}"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    notify 'Documents' "$1 not found" dialog-error critical
    exit 1
  }
}

menu_lines() {
  max="$1"

  awk -v max="$max" '
    END {
      lines = NR < 1 ? 1 : NR
      if (lines > max) {
        print max
      } else {
        print lines
      }
    }
  '
}

documents() {
  fd --type f . "$documents_dir" --exec stat --format '%Y %n' {} | sort -rn | cut -d ' ' -f2- | while IFS= read -r file; do
    rel="${file#"$documents_dir"/}"

    case "${file##*.}" in
      pdf) icon='' ;;
      md|markdown) icon='󰍔' ;;
      jpg|jpeg|png|webp|gif) icon='' ;;
      zip|tar|gz|xz|7z) icon='' ;;
      *) icon='󰈙' ;;
    esac

    printf '%s\t%s  %s\n' "$file" "$icon" "$rel"
  done
}

require fd
require fuzzel
require xdg-open

[ -d "$documents_dir" ] || {
  notify 'Documents' 'Documents folder not found' folder-documents critical
  exit 1
}

list="$(documents)"

[ -n "$list" ] || {
  notify 'Documents' 'No documents found' folder-documents critical
  exit 1
}

lines="$(printf '%s\n' "$list" | menu_lines 12)"
file="$(printf '%s\n' "$list" |
  fuzzel --dmenu --width 70 --lines "$lines" --prompt 'Document: ' --with-nth=2 --accept-nth=1)"

[ -n "$file" ] || exit 0

xdg-open "$file" >/dev/null 2>&1 &
notify 'Documents' "Opened ${file##*/}" folder-documents normal
