#!/bin/sh
set -eu

require() {
  command -v "$1" >/dev/null 2>&1 || {
    notify 'Open' "$1 not found" dialog-error critical
    exit 1
  }
}

menu_lines() {
  max="$1"

  awk -v max="$max" '
    END {
      lines = NR < 1 ? 1 : NR
      if (lines > max) {
        print max
      } else {
        print lines
      }
    }
  '
}

icon_for() {
  file="$1"

  case "${file##*.}" in
    jpg|jpeg|png|webp|gif|svg|bmp|avif) printf '' ;;
    mp4|mkv|webm|mov|avi) printf '󰕧' ;;
    mp3|flac|wav|ogg|m4a) printf '' ;;
    pdf|epub|djvu|ps) printf '' ;;
    md|markdown|txt|log) printf '󰍔' ;;
    doc|docx|odt|rtf) printf '󰈬' ;;
    xls|xlsx|ods|csv) printf '󰈛' ;;
    zip|tar|gz|xz|7z|rar) printf '' ;;
    *) printf '󰈙' ;;
  esac
}

recent_files() {
  for dir in \
    "${XDG_DOCUMENTS_DIR:-$HOME/Documents}" \
    "${XDG_DOWNLOAD_DIR:-$HOME/Downloads}" \
    "${XDG_PICTURES_DIR:-$HOME/Pictures}" \
    "${XDG_VIDEOS_DIR:-$HOME/Videos}" \
    "${XDG_MUSIC_DIR:-$HOME/Music}" \
    "${XDG_DESKTOP_DIR:-$HOME/Desktop}"; do
    [ -d "$dir" ] || continue
    fd \
      --type f \
      --exclude .git \
      --exclude .obsidian \
      --exclude .trash \
      --exclude '00 - Attachements' \
      . "$dir" --exec stat --format '%Y	%n' {}
  done |
    sort -rn |
    sed 100q |
    cut -f2- |
    while IFS= read -r file; do
      icon="$(icon_for "$file")"
      rel="${file#"$HOME"/}"
      printf '%s\t%s  %s\n' "$file" "$icon" "$rel"
    done
}

require fd
require fuzzel
require notify
require xdg-open

list="$(recent_files)"

[ -n "$list" ] || {
  notify 'Open' 'No files found' folder-documents normal
  exit 0
}

lines="$(printf '%s\n' "$list" | menu_lines 14)"
file="$(printf '%s\n' "$list" |
  fuzzel --namespace=fz-open --dmenu --width 74 --lines "$lines" --prompt 'Open: ' --with-nth=2 --accept-nth=1)"

[ -n "$file" ] || exit 0

xdg-open "$file" >/dev/null 2>&1 &
