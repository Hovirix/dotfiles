#!/bin/sh
set -eu

notes_dir="$HOME/Documents/notes"
idea_file="$notes_dir/idea.md"
todo_file="$notes_dir/todo.md"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    notify 'Notes' "$1 not found" dialog-error critical
    exit 1
  }
}

launch_note_window() {
  wezterm-gui start --always-new-process --class notes-scratch "$@" >/dev/null 2>&1 &
}

new_note() {
  title="$(fuzzel --namespace=fz-notes --dmenu --width 56 --prompt-only='New note: ')"
  [ -n "$title" ] || exit 0

  launch_note_window zk new --title "$title"
  notify 'Notes' 'Opening new note' accessories-text-editor normal
}

append_idea() {
  idea="$(fuzzel --namespace=fz-notes --dmenu --width 64 --prompt-only='Idea: ')"
  [ -n "$idea" ] || exit 0

  mkdir -p "$notes_dir"
  if [ ! -s "$idea_file" ]; then
    printf '# Ideas\n\n' > "$idea_file"
  fi

  printf -- '- %s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$idea" >> "$idea_file"
  notify 'Notes' 'Idea captured' accessories-text-editor normal
}

append_todo() {
  item="$(fuzzel --namespace=fz-notes --dmenu --width 64 --prompt-only='Todo: ')"
  [ -n "$item" ] || exit 0

  mkdir -p "$notes_dir"
  if [ ! -s "$todo_file" ]; then
    printf '# Todo\n\n' > "$todo_file"
  fi

  printf -- '- [ ] %s\n' "$item" >> "$todo_file"
  notify 'Notes' 'Todo added' checkbox normal
}

require fuzzel
require notify
require wezterm-gui
require zk

case "${1:-menu}" in
  new) new_note ;;
  add-idea) append_idea ;;
  add-todo) append_todo ;;
  menu)
    choice="$(printf '%s\n' \
      '  Idea' \
      '󰄱  Todo' \
      '󰎔  New note' |
      fuzzel --namespace=fz-notes --dmenu --width 32 --lines 3 --hide-prompt)"

    case "$choice" in
      '  Idea') append_idea ;;
      '󰄱  Todo') append_todo ;;
      '󰎔  New note') new_note ;;
      '') exit 0 ;;
    esac
    ;;
  *)
    notify 'Notes' "Unknown action: $1" dialog-error critical
    exit 1
    ;;
esac
