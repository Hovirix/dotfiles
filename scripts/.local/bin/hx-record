#!/usr/bin/env bash
set -euo pipefail

state="${XDG_RUNTIME_DIR:?}/hx-record"
exec 9>"$state.lock"
case "${1:-}" in
    --status)
        if [[ -s "$state.pid" ]] && ! flock -n 9; then
            exit 0
        fi
        exit 1
        ;;
    --stop)
        if ! flock -n 9; then
            [[ ! -s "$state.pid" ]] || kill -INT "$(cat "$state.pid")"
        fi
        exit 0
        ;;
    ""|--desktop-audio|--audio) ;;
    *) echo "Usage: hx-record [--desktop-audio|--audio|--stop|--status]" >&2; exit 1 ;;
esac
flock -n 9 || { echo "Recording already active" >&2; exit 1; }

geometry="$(
    mmsg get all-clients |
    jq -r '
        .clients[]
        | select(.is_visible and (.is_minimized | not))
        | "\(.x),\(.y) \(.width)x\(.height)"
    ' |
    slurp -o
)" || exit 0
[[ -n "$geometry" ]] || exit 0

children=()
recorder=""
cleanup() {
    trap '' INT TERM
    if [[ -n "$recorder" ]]; then
        kill -INT "$recorder" 2>/dev/null || true
        wait "$recorder" 2>/dev/null || true
    fi
    for pid in "${children[@]}"; do
        kill "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
    rm -f "$state.pid"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

audio=()
if [[ "${1:-}" == --audio || "${1:-}" == --desktop-audio ]]; then
    pw-loopback -n hx-record-mix \
        --capture-props='media.class=Audio/Sink node.name=hx-record-sink node.virtual=true priority.session=0' \
        --playback-props='media.class=Audio/Source node.name=hx-record-source node.virtual=true priority.session=0' &
    children+=("$!")
    if [[ "${1:-}" == --audio ]]; then
        pw-loopback -n hx-record-mic -C '@DEFAULT_AUDIO_SOURCE@' -P hx-record-sink &
        children+=("$!")
    fi
    pw-loopback -n hx-record-system -C '@DEFAULT_AUDIO_SINK@' \
        --capture-props='stream.capture.sink=true' -P hx-record-sink &
    children+=("$!")
    ready=false
    for ((attempt = 0; attempt < 50; attempt++)); do
        if pw-dump | jq -e 'any(.[]; .info.props["node.name"] == "hx-record-source")' >/dev/null; then
            ready=true
            break
        fi
        sleep 0.1
    done
    "$ready" || { echo "Recording audio source unavailable" >&2; exit 1; }
    audio=(--audio-backend=pipewire --audio=hx-record-source)
fi

dir="${XDG_VIDEOS_DIR:-$HOME/Videos}/Recordings"
mkdir -p "$dir"
file="$dir/recording-$(date '+%Y-%m-%d_%H-%M-%S').mkv"
wf-recorder -g "$geometry" "${audio[@]}" -f "$file" &
recorder=$!
echo "$recorder" > "$state.pid"
notify-send -i media-record "Recording" "Started; hx-record --stop to save"
wait "$recorder"
recorder=""
notify-send -i media-record "Recording saved" "$file"
