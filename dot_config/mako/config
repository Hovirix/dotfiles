sort=-time
max-visible=4
max-history=20
group-by=app-name,summary

default-timeout=3000
ignore-timeout=0

anchor=top-right
layer=overlay
outer-margin=12
margin=8
width=390
height=110
padding=14,16
border-size=1
border-radius=0

font=JetBrainsMono 12
markup=1
format=<b>%s</b>\n%b
text-alignment=left

icons=1
max-icon-size=42
icon-location=left
icon-border-radius=0
icon-path=/run/current-system/sw/share/icons/Papirus-Dark:/run/current-system/sw/share/icons/Papirus:/run/current-system/sw/share/icons/breeze-dark:/run/current-system/sw/share/icons/hicolor

background-color=#1e1e2ef2
text-color=#cdd6f4
border-color=#fab387
progress-color=over #89b4fa

on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all

[grouped]
format=(%g) <b>%s</b>\n%b

[urgency=low]
default-timeout=2000
border-color=#fab387

[app-name=Brightness]
width=320
height=56
padding=10,12
format=<b>%s</b>
default-timeout=700
border-color=#7f849c
progress-color=over #7f849c

[urgency=normal]
default-timeout=3500
border-color=#fab387

[urgency=critical]
default-timeout=0
border-color=#f38ba8
background-color=#1e1e2ef8
