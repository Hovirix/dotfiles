[branch]
    sort = -committerdate

[column]
    ui = auto

[commit]
    cleanup = whitespace
    gpgSign = true

[core]
    pager = delta

[credential]
    helper = cache

[delta]
    dark = true
    navigate = true
    features = catppuccin-mocha

[diff]
    algorithm = histogram
    colorMoved = default
    renames = true

[fetch]
    prune = true
    pruneTags = true

[include]
    path = ~/.config/delta/catppuccin.gitconfig

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictStyle = zdiff3

[pull]
    ff = only

[push]
    autoSetupRemote = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[rerere]
    enabled = true

[tag]
    gpgSign = true
    sort = -version:refname

[transfer]
    credentialsInUrl = die

[user]
    email = contact@hovirix.dev
    name = hovirix
    signingKey = 80C893688DADB629
    useConfigOnly = true
