{
  "layer": "top",
  "output": "eDP-1",
  "position": "top",
  "spacing": 8,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "network",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "memory",
    "custom/sep",
    "cpu",
    "custom/sep",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
  },

  "clock": {
    "format": " {:%A %d %b %H:%M}"
  },

  "custom/sep": {
    "format": "|",
    "tooltip": false
  },

  "network": {
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-linked": "󰈀 {ifname}",
    "format-disconnected": "󰖪",
    "format-disabled": "󰖪",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ]
  },

  "pulseaudio": {
    "format": "VOL: {volume}%",
    "format-bluetooth": "{icon} {volume}% ",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": [
        "󰕿 ",
        "󰖀 ",
        "󰕾 ",
        "󰖀 ",
        "󰕾 ",
        "󰖀 ",
        "󰕾 "
      ]
    }
  },

  "memory": {
  "interval": 5,
  "format": "MEM: {used}GB"
},

  "cpu": {
    "interval": 1,
    "format": "CPU: {usage}%"
  },

  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-icons": {
      "default": [
        "",
        "",
        "",
        "",
        ""
      ],
      "charging": [
        " ",
        " ",
        " ",
        " ",
        " "
      ]
    }
  }
}
