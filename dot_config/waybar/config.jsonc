{
  "layer": "top",
  "output": "eDP-1",
  "position": "top",
  "spacing": 8,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "network",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "memory",
    "custom/sep",
    "cpu",
    "custom/sep",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X"
    }
  },

  "clock": {
    "format": " {:%a %d %b %H:%M}"
  },

  "custom/sep": {
    "format": "│",
    "tooltip": false
  },

  "network": {
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰖪",
    "format-disabled": "󰖪",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ]
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}% ",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": [
        "󰕿",
        "󰕿",
        "󰖀",
        "󰖀",
        "󰖀",
        "󰕾",
        "󰕾",
        "󰕾",
        "󰕾"
      ]
    }
  },

  "memory": {
    "interval": 5,
    "format": " {used}"
  },

  "cpu": {
    "interval": 1,
    "format": " {usage}%"
  },

  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-icons": {
      "default": [
        "",
        "",
        "",
        "",
        ""
      ],
      "charging": [
        " ",
        " ",
        " ",
        " ",
        " "
      ]
    }
  }
}
