general {
  colors = true
  interval = 1
  markup = "pango"
  output_format = "i3bar"
}

order += "wireless _first_"
order += "volume master"
order += "memory"
order += "cpu_usage"
order += "battery 0"
order += "time"

wireless _first_ {
  format_up = "<span color='#cba6f7'>󰤨 %essid</span>"
  format_down = "<span color='#cba6f7'>󰖪</span>"
}

volume master {
  format = "<span color='#89b4fa'> %volume</span>"
  format_muted = "<span color='#89b4fa'></span>"
}

memory {
  format = "<span color='#f5c2e7'> %used</span>"
  threshold_degraded = "10%"
  format_degraded = "<span color='#f9e2af'> %used</span>"
}

cpu_usage {
  format = "<span color='#f38ba8'> %usage</span>"
}

battery 0 {
  format = "<span color='#a6da95'>%status %percentage</span>"
  integer_battery_capacity = true
  color_bad = "#f38ba8"
  low_threshold = 30
  status_bat = ""
  status_chr = ""
  status_full = ""
  status_unk = ""
}

time {
  format = "<span color='#cdd6f4'> %a %d %b %H:%M</span> "
}
