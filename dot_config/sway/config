# ------------------------------------------------
# Sway core
# ------------------------------------------------

include /etc/sway/config.d/*

xwayland disable
seat * xcursor_theme Bibata-Modern-Amber 24
seat * shortcuts_inhibitor disable

# ------------------------------------------------
# Variables
# ------------------------------------------------

set $mod Mod4

set $ws1  "1:I"
set $ws2  "2:II"
set $ws3  "3:III"
set $ws4  "4:IV"
set $ws5  "5:V"
set $ws6  "6:VI"
set $ws7  "7:VII"
set $ws8  "8:VIII"
set $ws9  "9:IX"
set $ws10 "10:X"

set $rosewater #f5e0dc
set $flamingo #f2cdcd
set $pink #f5c2e7
set $mauve #cba6f7
set $red #f38ba8
set $maroon #eba0ac
set $peach #fab387
set $yellow #f9e2af
set $green #a6e3a1
set $teal #94e2d5
set $sky #89dceb
set $sapphire #74c7ec
set $blue #89b4fa
set $lavender #b4befe
set $text #cdd6f4
set $subtext1 #bac2de
set $subtext0 #a6adc8
set $overlay2 #9399b2
set $overlay1 #7f849c
set $overlay0 #6c7086
set $surface2 #585b70
set $surface1 #45475a
set $surface0 #313244
set $base #1e1e2e
set $mantle #181825
set $crust #11111b

# ------------------------------------------------
# Autostart
# ------------------------------------------------

exec {
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_DATA_DIRS
  autotiling-rs
  wlsunset -t 3000 -T 6500 -s 21:00 -S 07:00
  swayidle -w -C ~/.config/sway/swayidle.conf
}

exec {
  flatpak run io.gitlab.librewolf-community
}

# ------------------------------------------------
# Outputs
# ------------------------------------------------

output * bg ~/Pictures/Wallpapers/nixos-mocha.png fill

output eDP-1 {
  scale 1.5
  mode 2880x1800@120.000Hz
  render_bit_depth 10
}

output HDMI-A-1 {
  scale 1.25
  pos 0 0
  mode 2560x1440
}

# ------------------------------------------------
# Inputs
# ------------------------------------------------

input type:keyboard {
  xkb_layout us,us
  xkb_variant ,intl
  xkb_options ctrl:nocaps
}

input type:touchpad {
  dwt enabled
  tap enabled
  pointer_accel 1
  accel_profile flat
  natural_scroll enabled
}

input type:mouse {
  pointer_accel 0
  accel_profile flat
}

# ------------------------------------------------
# Window
# ------------------------------------------------

default_border pixel 2
default_floating_border pixel 2
titlebar_border_thickness 0
titlebar_padding 0 0
hide_edge_borders both
floating_modifier $mod
focus_on_window_activation focus

# -------------------------------
# Window Rules
# -------------------------------

for_window [app_id="(?i).*librewolf.*"]    move to workspace $ws1, focus
for_window [app_id="(?i).*virt-manager.*"] move to workspace $ws2, focus
for_window [app_id="(?i).*qemu.*"]         move to workspace $ws2, focus
for_window [app_id="(?i).*wezterm.*"]      move to workspace $ws3, focus
for_window [app_id="(?i).*obsidian.*"]     move to workspace $ws4, focus
for_window [app_id="(?i).*freetube.*"]     move to workspace $ws5, focus
for_window [app_id="notes-scratch"]        floating enable, move scratchpad, scratchpad show, focus

# -------------------------------
# Workspace
# -------------------------------

workspace $ws1  output eDP-1
workspace $ws2  output eDP-1
workspace $ws3  output eDP-1
workspace $ws4  output eDP-1
workspace $ws5  output eDP-1
workspace $ws6  output HDMI-A-1
workspace $ws7  output HDMI-A-1
workspace $ws8  output HDMI-A-1
workspace $ws9  output HDMI-A-1
workspace $ws10 output HDMI-A-1

# -------------------------------
# Keybindings
# -------------------------------

bindcode $mod+9             scratchpad show
bindcode $mod+10            workspace $ws1
bindcode $mod+11            workspace $ws2
bindcode $mod+12            workspace $ws3
bindcode $mod+13            workspace $ws4
bindcode $mod+14            workspace $ws5
bindcode $mod+15            workspace $ws6
bindcode $mod+16            workspace $ws7
bindcode $mod+17            workspace $ws8
bindcode $mod+18            workspace $ws9
bindcode $mod+19            workspace $ws10

bindcode $mod+Shift+9       move scratchpad
bindcode $mod+Shift+10      move container to workspace $ws1, workspace $ws1
bindcode $mod+Shift+11      move container to workspace $ws2, workspace $ws2
bindcode $mod+Shift+12      move container to workspace $ws3, workspace $ws3
bindcode $mod+Shift+13      move container to workspace $ws4, workspace $ws4
bindcode $mod+Shift+14      move container to workspace $ws5, workspace $ws5
bindcode $mod+Shift+15      move container to workspace $ws6, workspace $ws6
bindcode $mod+Shift+16      move container to workspace $ws7, workspace $ws7
bindcode $mod+Shift+17      move container to workspace $ws8, workspace $ws8
bindcode $mod+Shift+18      move container to workspace $ws9, workspace $ws9
bindcode $mod+Shift+19      move container to workspace $ws10, workspace $ws10

# Apps
bindsym $mod+R                 exec fuzzel
bindsym $mod+Return            exec wezterm-gui
bindsym Control+1              exec flatpak run io.gitlab.librewolf-community
bindsym Control+2              exec virt-manager
bindsym Control+4              exec flatpak run md.obsidian.Obsidian
bindsym Control+5              exec flatpak run io.freetubeapp.FreeTube

# Scripts
bindsym $mod+c                 exec swayidle-toggle
bindsym $mod+p                 exec fz-pass
bindsym $mod+a                 exec fz-audio
bindsym $mod+v                 exec fz-vm
bindsym $mod+d                 exec fz-display
bindsym $mod+w                 exec fz-wifi
bindsym $mod+Shift+w           exec fz-bluetooth
bindsym $mod+n                 exec fz-notes
bindsym $mod+o                 exec fz-open
bindsym $mod+space             exec keyboard-layout-toggle

# Screenshots
bindsym $mod+s                 exec fz-screenshot

# Brightness
bindsym $mod+b                exec fz-battery
bindsym XF86MonBrightnessUp   exec brightness-osd up
bindsym XF86MonBrightnessDown exec brightness-osd down

# Audio
bindsym XF86AudioMute          exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioLowerVolume   exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-
bindsym XF86AudioRaiseVolume   exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ -l 1

# Window management
bindsym $mod+q               kill
bindsym $mod+t               floating toggle
bindsym $mod+f               fullscreen toggle

# Sway
bindsym $mod+Shift+e         exec fz-power
bindsym $mod+Shift+r         exec swaymsg reload

# Sys
bindsym $mod+Shift+Ctrl+s    exec loginctl suspend

# Focus / move
bindsym $mod+h               focus left
bindsym $mod+l               focus right
bindsym $mod+k               focus up
bindsym $mod+j               focus down

bindsym $mod+Shift+h         move left
bindsym $mod+Shift+l         move right
bindsym $mod+Shift+k         move up
bindsym $mod+Shift+j         move down

bindsym $mod+Ctrl+h          resize shrink width 10px
bindsym $mod+Ctrl+l          resize grow width 10px
bindsym $mod+Ctrl+k          resize shrink height 10px
bindsym $mod+Ctrl+j          resize grow height 10px

# -------------------------------
# Gaps / borders
# -------------------------------

smart_borders on

# -------------------------------
# Colors
# -------------------------------

# target                 title     bg    text   indicator  border
client.focused           $peach    $base $text  $rosewater $peach
client.focused_inactive  $overlay0 $base $text  $rosewater $overlay0
client.unfocused         $overlay0 $base $text  $rosewater $overlay0
client.urgent            $red      $base $red   $overlay0  $red
client.placeholder       $overlay0 $base $text  $overlay0  $overlay0
client.background        $base

# -------------------------------
# Bar
# -------------------------------

bar {
  bindsym button1  nop
  bindsym button2  nop
  bindsym button3  nop
  bindsym button4  nop
  bindsym button5  nop
  bindsym button6  nop
  bindsym button7  nop
  bindsym button8  nop
  bindsym button9  nop

  font JetBrainsMono 10
  output eDP-1
  position top
  separator_symbol " │ "
  status_command i3status
  strip_workspace_numbers yes

  colors {
    background         $base
    statusline         $text
    separator          $subtext0
    focused_statusline $text
    focused_separator  $subtext0

    # target           border bg        text
    focused_workspace  $base  $peach    $crust
    active_workspace   $base  $surface2 $text
    inactive_workspace $base  $base     $text
    urgent_workspace   $base  $red      $crust
  }
}
